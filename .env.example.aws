# https://docs.docker.com/compose/environment-variables/
# https://django-environ.readthedocs.io/en/latest/#django-environ

# REQUIRED: generate a unique, random key per deployment, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The app refuses to start on a real (non-localhost) domain while this is left
# as the 'Change.Me!' default.
SECRET_KEY=Change.Me!

# Must be False for any real (non-localhost) deployment; the app enforces this.
DEBUG=False

## ROOT DOMAIN ################################
#
# This value is used to set many other variables including:
#  -domain_url for the public tenant
#  -domain and name for the Site model object (see https://docs.djangoproject.com/en/3.1/ref/contrib/sites/ )
#  -Django's ALLOWED_HOSTS = "." + ROOT_DOMAIN
#

ROOT_DOMAIN=bytedeck.com
#ROOT_DOMAIN=localhost

# You can set ALLOWED_HOSTS seperately if needed, otherwise it will use
# "." + ROOT_DOMAIN which will allow the public tenants
# comma seperated list
#ALLOWED_HOSTS=.localhost

# CSRF_TRUSTED_ORIGINS is required in production:
#CSRF_TRUSTED_ORIGINS=https://*.domain.com

# User and Group
WUID=1000
WGID=999

## EMAIL ######################################

#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_FILE_PATH

#EMAIL_HOST=
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=

EMAIL_PORT=587
EMAIL_USE_TLS=True

#DEFAULT_FROM_EMAIL=

# Where "Contact ByteDeck" links in subscription-related copy point
# (rendered as mailto: links). Defaults to contact@bytedeck.com.
#SUPPORT_EMAIL=

# SERVER ERRORS EMAIL (comma seperated list)
ADMINS=Admin Name:admin@exmaple.com,Admin2 Name:admin2@exmaple.com
#SERVER_EMAIL=server@example.com
#EMAIL_SUBJECT_PREFIX=


## MEDIA AND STATIC FILES ##############################

#MEDIA_ROOT=
#STATIC_ROOT=
#STATICFILES_DIRS=('/var/www/static/', 'etc',)


## REDIS ###############################################

# Redis runs as the `redis` compose service on the internal backend-network
# (docker-compose.prod.aws.yml), so the app reaches it by service name.
REDIS_HOST=redis

REDIS_PORT=6379

# Optional: cap the Redis container's memory so it can't starve the app host.
# Consumed by the redis service command in docker-compose.prod.aws.yml.
# Defaults to 512mb. With noeviction, reaching the cap makes redis reject any
# command that needs more memory, so celery publishes fail too, not just cache
# writes. Size it to the instance + working set, leaving host headroom because
# the process sits a bit above maxmemory (allocator overhead, fragmentation).
#REDIS_MAXMEMORY=512mb


## CAPACITY / SCALING #################################

# Extra uwsgi flags appended to the web container's `uwsgi --ini` command
# (later flags win), so the worker ceiling can be raised without editing
# src/uwsgi.aws.ini. The in-file default (processes=6) suits c5a.large; raise
# it after bumping the instance, and unset it again on the way back down.
# Size to the instance: processes * peak-worker-RSS must leave headroom for
# celery + redis + the OS, so the example below suits c5a.xlarge/8 GiB and is
# NOT generic. See production/SEPTEMBER-RUNBOOK.md.
#UWSGI_EXTRA_ARGS=--processes 8


## POSTGRES ############################################

# Point this at the managed database endpoint (e.g. the AWS RDS endpoint) in
# production/staging.
POSTGRES_HOST=your-db.xxxxxxxxxxxx.region.rds.amazonaws.com

POSTGRES_PORT=5432
POSTGRES_DB_NAME=postgres
POSTGRES_USER=postgres

# REQUIRED in production: the password for the Postgres user above.
POSTGRES_PASSWORD=

# POSTGRES_HOST_AUTH_METHOD=trust is a *local-dev* convenience for the
# containerized postgres (see .env.example); it does not apply to a managed DB
# like RDS. Never enable passwordless trust auth in production.
#POSTGRES_HOST_AUTH_METHOD=trust


## PUBLIC TENANT  ######################################

# Used to login to the public tenant admin
DEFAULT_SUPERUSER_USERNAME=admin
DEFAULT_SUPERUSER_PASSWORD=password
#DEFAULT_SUPERUSER_EMAIL=


## TENANTS ##############################################

TENANT_DEFAULT_ADMIN_USERNAME=admin
TENANT_DEFAULT_ADMIN_PASSWORD=password
#TENANT_DEFAULT_ADMIN_EMAIL=

TENANT_DEFAULT_OWNER_USERNAME=owner
TENANT_DEFAULT_OWNER_PASSWORD=password
#TENANT_DEFAULT_OWNER_EMAIL=


# RECAPTCHA #######################################################

#RECAPTCHA_PUBLIC_KEY=
#RECAPTCHA_PRIVATE_KEY=


# STATIC AND MEDIA FILES
# 1 = serve static & media from S3/CloudFront (the production/staging setup).
# Set to 0 only if you intend to serve them locally from nginx instead.
USE_S3=1

# AWS

# To connect to AWS(S3) either
# 1. keep the access key and secret blank to use the IAM role linked to ec2 machine (default connection)
# 2. OR specify the real value to use a specific IAM user
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CDN
CDN_static=xxxxxxxx.cloudfront.net

# S3
AWS_STORAGE_BUCKET_NAME=xxxx

# STRIPE (#1729) ##################################################
# Automated deck subscriptions. Leave unset to run without Stripe: the
# subscription page then shows "billing not configured" and links to the
# public subscribe page instead. Where each value comes from (use test-mode
# sk_test_/pk_test_ keys on staging, live keys in production):
# - STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY: Dashboard > Developers >
#   API keys. The publishable key is currently unused by the redirect-based
#   Checkout flow, so it may stay unset.
# - STRIPE_PRICE_ID: the id of the PRICE the deck "Subscribe now" button
#   sells (product page > price row > "Copy price ID", a price_... string,
#   not the prod_... product id). Other prices are only reachable through
#   the Customer Portal configuration.
# - STRIPE_WEBHOOK_SECRET: the signing secret shown when registering the
#   webhook endpoint (/decks/stripe/webhook/ on the root domain). Set it in
#   the SAME edit as STRIPE_SECRET_KEY: on a non-localhost ROOT_DOMAIN the
#   app refuses to boot with the secret key alone.
# Student caps come from max_active_users metadata set on each PRICE in the
# dashboard (prices do NOT inherit Product metadata; product-level metadata
# is never read).
# All STRIPE_* values must come from the SAME Stripe account and mode: pair
# test-mode keys with test-mode price ids and webhook secret (and live with
# live); each mode's objects are invisible to the other mode's keys.
#STRIPE_PUBLISHABLE_KEY=
#STRIPE_SECRET_KEY=
#STRIPE_PRICE_ID=
#STRIPE_WEBHOOK_SECRET=
# Optional fallback for prices that lack max_active_users metadata: a JSON
# map of REAL price ids to caps ("price_abc" below is a placeholder). Must be
# valid JSON or every process fails at boot. Prefer price metadata instead.
#STRIPE_PRICE_TIER_MAP={"price_abc": 40}

# DEMO DECK #######################################################
# Course code for the public demo deck (learn.bytedeck.com), shown on the
# deck-request page. Kept out of source control; when unset the page links
# the demo deck without printing a code.
#DEMO_DECK_COURSE_CODE=

# DECK STATUS NOTICES (#1729/#1733) ###############################
# When unset/False the nightly deck-status task runs REPORT-ONLY: it logs which
# expiry/limit/suspension notices it would send, but sends and records nothing.
# Enable after reviewing a report-only cycle in the worker logs.
#DECK_NOTICES_ENABLED=True
