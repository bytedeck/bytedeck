# Keep the build context (COPY . /app/) small, cache-friendly, and free of
# secrets. This governs what is baked into the image itself: its size, its layer
# caching, and anything that could leak if the image is ever shared. Production
# runs that image directly, so what is excluded here is simply absent there;
# development mounts the host checkout over /app, which puts it all back.

# Secrets -- never bake these into an image layer
.env
.env.production
*.pem

# VCS (large, cache-busting, and unneeded in the image)
.git

# User uploads / generated content
_media_uploads/
media_root/
_sent_mail/

# Collected static (regenerated by collectstatic)
_collected_static/
collected_static/
local_static_root/
static_in_venv/

# Test/coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# Python bytecode and local virtualenvs
__pycache__/
*.py[cod]
venv/
env/

# Editor/tooling cruft
.idea/
.vscode/
*.code-workspace

# Runtime droppings
celerybeat.pid
*.sqlite3
*.log
