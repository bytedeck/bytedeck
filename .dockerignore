# Keep the build context (COPY . /app/) small, cache-friendly, and free of
# secrets. Note: at runtime docker-compose bind-mounts the repo over /app, so
# this governs what's baked into the image itself (size, layer caching, and
# anything that could leak if the image is ever shared).

# Secrets -- never bake these into an image layer
.env
.env.production
*.pem

# VCS (large, cache-busting, and unneeded in the image)
.git

# User uploads / generated content
_media_uploads/
media_root/
_sent_mail/

# Collected static (regenerated by collectstatic)
_collected_static/
collected_static/
local_static_root/
static_in_venv/

# Test/coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# Python bytecode and local virtualenvs
__pycache__/
*.py[cod]
venv/
env/

# Editor/tooling cruft
.idea/
.vscode/
*.code-workspace

# Runtime droppings
celerybeat.pid
*.sqlite3
*.log
